{
	"name": "calendar-plus",
	"version": "0.1.0",
	"description": "Obsidian calendar for periodic notes, extensible by other plugins",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"calendar",
		"periodic-notes"
	],
	"license": "MIT",
	"packageManager": "pnpm@11.17.0",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"moment": "2.29.4",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
